# Copy to backend/.env (preferred) or to the repository root as .env.

# Required for AI features: resume skill discovery, assessment question
# generation and short-answer grading. Never commit the real key.
GROQ_API_KEY=

# The database is configured further down (DATABASE_URL, PostgreSQL by default).
# SQLite is still possible for quick experiments: DATABASE_URL=sqlite:///hiring.db

# Login sessions: days a login stays valid (sliding; each device has its own session).
# SESSION_DAYS=30
# Frontend origins allowed by CORS (comma separated).
# FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Resume ATS checks are free for candidates by default; set a credit cost to charge.
# CREDIT_COST_ATS_CHECK=0
# Code runner: docker (recommended in production), local, or disabled.
# Default: local on Linux/macOS; on Windows docker if available, else local.
# CODE_RUNNER=docker

# ---- Database (PostgreSQL) -------------------------------------------------
# See docs/POSTGRESQL_PGADMIN_SETUP.md. Format: postgresql+psycopg2://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql+psycopg2://hirelune:hirelune_pw@localhost:5432/hirelune
# Create the database automatically if the user is allowed to (true/false).
# DB_AUTO_CREATE=true
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# Load the 5 demo companies, HRs, jobs and candidates once on first start.
SEED_DEMO_DATA=false
